# Baton — server-side environment variables
# Copy to web/.env.local and fill in your own values. Never commit real values.

# ── Language model ─────────────────────────────────────────────────────
# Any OpenAI-compatible chat completions endpoint works, so the provider is a
# config choice. Baton ships pointing at NVIDIA NIM with Llama 3.1 70B.
#
#   NVIDIA NIM : https://integrate.api.nvidia.com/v1 key from build.nvidia.com
#   OpenRouter : https://openrouter.ai/api/v1        key from openrouter.ai/keys
#   Local vLLM : http://127.0.0.1:8000/v1            any placeholder key
#
# Note: NVIDIA grants entitlement per model. If a call returns 404
# "Function ... Not found for account", generate the key from that model's own
# page rather than the account page.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_API_KEY=

# ── DataHub ────────────────────────────────────────────────────────────
# GMS endpoint. Use http://localhost:8080 when Baton runs on the same host as
# `datahub docker quickstart` — that is the recommended deployment, because it
# keeps GMS unreachable from the internet.
DATAHUB_GMS_URL=http://localhost:8080

# Personal access token: DataHub UI > Settings > Access Tokens
DATAHUB_GMS_TOKEN=

# Lets the Publisher agent write back (add_tags, update_description)
TOOLS_IS_MUTATION_ENABLED=true

# The DataHub MCP server, run as a stdio sidecar. Pin the version: with
# `@latest` the sidecar can change under a running deployment — ours moved from
# DataHub SDK 3.4.5 to 3.4.6 on its own, and a tool rename would break the app
# with no commit to point at. Note the PyPI version (0.6.0) is not the version
# the server reports over MCP (3.4.6); pin the PyPI one.
MCP_COMMAND=uvx
MCP_ARGS=mcp-server-datahub@0.6.0

# ── SQL validation ─────────────────────────────────────────────────────
# The Python sqlglot service in validator/
VALIDATOR_URL=http://127.0.0.1:8100

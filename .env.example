# Baton — server-side environment variables
# Copy to .env and fill in your own values. Never commit .env.

# Anthropic API key (server-side only — never expose with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# DataHub GMS endpoint (e.g. http://localhost:8080 for local quickstart)
DATAHUB_GMS_URL=

# DataHub personal access token (Settings > Access Tokens in the DataHub UI)
DATAHUB_GMS_TOKEN=
